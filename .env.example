# Copy this file to .env and add your own Gemini API key.
# Get a key at https://aistudio.google.com/apikey. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Search: hybrid (keywords + embeddings, default) or bm25 (keywords only, no embedding calls)
RETRIEVAL_MODE=hybrid
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: where saved cases are stored (default: ./data)
# DEAL_SCREENING_DATA_DIR=
